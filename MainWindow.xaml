<Window x:Class="BO2InjectorGUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BO2 Injector" Width="520" ResizeMode="CanMinimize" SizeToContent="Height" Background="#0B0C0E" Foreground="#E8EAF0" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" xmlns:bo2injectorgui="clr-namespace:BO2InjectorGUI;assembly=BO2InjectorGUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="BigBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#1A1D24" />
        <Setter Property="Foreground" Value="#E8EAF0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#2E333F" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12" Padding="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#242832" />
                  <Setter Property="BorderBrush" Value="#FF7A00" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="#5A6172" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GoBtn" BasedOn="{StaticResource BigBtn}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FF7A00" />
        <Setter Property="Foreground" Value="#0B0C0E" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#14161B" />
        <Setter Property="Foreground" Value="#E8EAF0" />
        <Setter Property="BorderBrush" Value="#2E333F" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="28,20,28,16">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Name="dot" Width="13" Height="13" Fill="#7A3030" Margin="0,0,10,0" />
      <TextBlock Text="BO2  INJECTOR" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" />
    </StackPanel>
    <TextBlock Text="PS4DEBUG  •  GOLDHEN" FontSize="10" Foreground="#FF7A00" Margin="33,0,0,2" />
    <Rectangle Height="2" Fill="#FF7A00" Margin="0,6,0,14" RadiusX="1" RadiusY="1" />
    <TextBlock Name="lblStatus" Text="Disconnected" Foreground="#9AA0B0" FontSize="12" Margin="0,0,0,14" />
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="PS4 IP" Foreground="#9AA0B0" FontSize="11" Margin="0,0,0,4" />
        <TextBox Name="txtIp" Text="192.168.100.66" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="gsc file" Foreground="#9AA0B0" FontSize="11" Margin="0,0,0,4" />
        <TextBox Name="txtFile" IsReadOnly="True" Text="No file selected" />
      </StackPanel>
    </Grid>
    <UniformGrid Columns="2" Rows="2" Margin="0,2,0,0">
      <Button Name="btnConnect" Content="Connect" Style="{StaticResource BigBtn}" Height="52" Margin="0,0,5,5" />
      <Button Name="btnAttach" Content="Attach" Style="{StaticResource BigBtn}" Height="52" Margin="5,0,0,5" />
      <Button Name="btnSel" Content="Select GSC" Style="{StaticResource BigBtn}" Height="52" Margin="0,5,5,0" />
      <Button Name="btnInj" Content="INJECT" Style="{StaticResource BigBtn}" Height="52" Margin="5,5,0,0" FontSize="16" FontWeight="Bold" />
    </UniformGrid>
    <Button Name="btnPublic" Content="PUBLIC MATCH" Style="{StaticResource GoBtn}" Height="40" Margin="0,10,0,0" FontSize="14" FontWeight="Bold" />
    <TextBox Name="txtLog" Margin="0,10,0,0" Height="80" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
      <TextBlock Text="by Medo" Foreground="#9AA0B0" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
      <Button Name="btnCoffee" Style="{StaticResource BigBtn}" Height="32" Padding="16,0,16,0" ToolTip="https://ko-fi.com/imedo">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M4,8 L13,8 L12.4,15 A2.8,2.8 0 0 1 9.6,17.8L7,17.8 A2.6,2.6 0 0 1 4.4,15.2M13,9.5 A2.6,2.6 0 0 1 13,14.5M3,20 L15,20" Stroke="#FF7A00" StrokeThickness="1.6" Fill="#00FFFFFF" Width="12" Height="14" Stretch="Uniform" />
          <TextBlock Text="Coffee" Foreground="#E8EAF0" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>