<Window x:Class="BO2InjectorGUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BO2 Injector" Width="540" ResizeMode="CanMinimize" SizeToContent="Height" Foreground="#EEF0F5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" xmlns:bo2injectorgui="clr-namespace:BO2InjectorGUI;assembly=BO2InjectorGUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type TextBox}" BasedOn="{StaticResource GlassTextBox}" TargetType="{x:Type TextBox}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Window.Background>
    <StaticResource ResourceKey="Backdrop" />
  </Window.Background>
  <Border Background="{StaticResource Surface}" Padding="28,20,28,16">
    <StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Name="dot" Width="13" Height="13" Fill="#7A3030" Margin="0,0,10,0">
          <Ellipse.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#7A3030" />
          </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="BO2  INJECTOR" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" />
      </StackPanel>
      <TextBlock Text="PS4DEBUG  •  GOLDHEN" FontSize="10" Foreground="{StaticResource Accent}" Margin="33,0,0,2" />
      <Rectangle Height="2" Margin="0,6,0,14" RadiusX="1" RadiusY="1">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF7A00" Offset="0" />
            <GradientStop Color="#00FF7A00" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <TextBlock Name="lblStatus" Text="Disconnected" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,12" />
      <Border Style="{StaticResource GlassInset}" CornerRadius="20" Margin="0,0,0,4">
        <UniformGrid Columns="2">
          <RadioButton Name="segMp" Content="MULTIPLAYER" Style="{StaticResource Seg}" GroupName="game" IsChecked="True" />
          <RadioButton Name="segZm" Content="ZOMBIES" Style="{StaticResource Seg}" GroupName="game" />
        </UniformGrid>
      </Border>
      <Border Name="subRow" Style="{StaticResource GlassInset}" CornerRadius="13" Margin="90,0,90,4">
        <UniformGrid Columns="2">
          <RadioButton Name="segMenus" Content="MOD MENUS" Style="{StaticResource SegSmall}" GroupName="mpkind" IsChecked="True" />
          <RadioButton Name="segGm" Content="GAME MODES" Style="{StaticResource SegSmall}" GroupName="mpkind" />
        </UniformGrid>
      </Border>
      <TextBlock Name="lblTarget" Text="maps/mp/gametypes/_clientids.gsc" Foreground="{StaticResource TextFaint}" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,12" />
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="PS4 IP" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,4" />
          <TextBox Name="txtIp" Text="192.168.100.66" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="gsc file" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,4" />
          <TextBox Name="txtFile" IsReadOnly="True" Text="No file selected" />
        </StackPanel>
      </Grid>
      <UniformGrid Columns="2" Rows="1" Margin="0,2,0,0">
        <Button Name="btnConnect" Content="Connect" Style="{StaticResource BigBtn}" Height="52" Margin="0,0,5,0" />
        <Button Name="btnAttach" Content="Attach" Style="{StaticResource BigBtn}" Height="52" Margin="5,0,0,0" />
      </UniformGrid>
      <Button Name="btnLib" Content="Library" Style="{StaticResource BigBtn}" Height="52" Margin="0,10,0,0" />
      <Button Name="btnInj" Content="INJECT" Style="{StaticResource BigBtn}" Height="48" Margin="0,10,0,0" FontSize="16" FontWeight="Bold" BorderBrush="{StaticResource Accent}" />
      <Button Name="btnPublic" Content="PUBLIC MATCH" Style="{StaticResource GoBtn}" Height="40" Margin="0,10,0,0" />
      <Button Name="btnUninject" Content="UNINJECT ALL" Style="{StaticResource BigBtn}" Height="40" Margin="0,8,0,0" FontSize="13" FontWeight="Bold" ToolTip="Restore the stock script(s) replaced by this session. Start a new match afterwards." />
      <Border Style="{StaticResource GlassInset}" Margin="0,10,0,0" Padding="10,2,4,2">
        <DockPanel>
          <TextBlock Text="&gt;" DockPanel.Dock="Left" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Name="btnSend" Content="SEND" DockPanel.Dock="Right" Style="{StaticResource MiniBtn}" VerticalAlignment="Center" Margin="6,0,0,0" />
          <Grid>
            <TextBox Name="txtCmd" Background="#00000000" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="0,4,0,4" VerticalContentAlignment="Center" />
            <TextBlock Name="lblCmdHint" Text="console command  ·  Enter to send, arrows for history" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </DockPanel>
      </Border>
      <RichTextBox Name="txtLog" Style="{StaticResource GlassRich}" Margin="0,8,0,0" Height="100" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11">
        <FlowDocument PagePadding="0" />
      </RichTextBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
        <TextBlock Text="by Aban" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="  ·  thank you Medo for the base" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
