<Window x:Class="BO2InjectorGUI.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Library" Width="520" Height="560" ResizeMode="NoResize" Background="#0B0C0E" Foreground="#E8EAF0" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="GoBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FF7A00" />
        <Setter Property="Foreground" Value="#0B0C0E" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="12" Padding="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Background" Value="#3A2A18" />
                  <Setter Property="Foreground" Value="#7A5A38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#14161B" />
        <Setter Property="Foreground" Value="#E8EAF0" />
        <Setter Property="BorderBrush" Value="#2E333F" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CaretBrush" Value="#FF7A00" />
      </Style>
      <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="row" Background="#00000000" BorderBrush="#00000000" BorderThickness="3,0,0,0" Padding="12,7,12,7" Margin="0,1,0,1" CornerRadius="0,8,8,0">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="row" Property="Background" Value="#1A1D24" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="row" Property="Background" Value="#242832" />
                  <Setter TargetName="row" Property="BorderBrush" Value="#FF7A00" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel Margin="24,18,24,16">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="LIBRARY" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" />
        <TextBlock Name="lblMode" Text="MULTIPLAYER" FontSize="20" FontWeight="Black" Foreground="#FF7A00" Margin="10,0,0,0" />
      </StackPanel>
      <TextBlock Name="lblCount" Text="" FontSize="10" Foreground="#5A6172" Margin="1,0,0,8" />
      <Grid Margin="0,0,0,8">
        <TextBox Name="txtSearch" />
        <TextBlock Name="lblHint" Text="search packs" Foreground="#5A6172" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <TextBox Name="txtNotes" Height="96" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#9AA0B0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Button Name="btnUse" Grid.Column="0" Content="USE THIS PACK" Style="{StaticResource GoBtn}" Height="40" IsEnabled="False" />
        <Button Name="btnCustom" Grid.Column="2" Content="CUSTOM GSC" Style="{StaticResource GoBtn}" Height="40" Background="#1A1D24" Foreground="#E8EAF0" ToolTip="Pick your own PS4-format .gscc / .gsc file instead of a bundled pack" />
      </Grid>
    </StackPanel>
    <Border Background="#14161B" BorderBrush="#2E333F" BorderThickness="1" CornerRadius="12" Padding="4">
      <ListBox Name="list" Background="#00000000" BorderThickness="0" Foreground="#E8EAF0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#9AA0B0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
