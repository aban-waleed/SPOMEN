<Window x:Class="BO2InjectorGUI.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Library" Width="540" Height="580" ResizeMode="NoResize" Foreground="#EEF0F5" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type TextBox}" BasedOn="{StaticResource GlassTextBox}" TargetType="{x:Type TextBox}" />
      <Style x:Key="{x:Type ListBoxItem}" BasedOn="{StaticResource GlassListItem}" TargetType="{x:Type ListBoxItem}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Window.Background>
    <StaticResource ResourceKey="Backdrop" />
  </Window.Background>
  <Border Style="{StaticResource GlassPanel}" Margin="16,14,16,16" Padding="22,18,22,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="LIBRARY" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" />
          <TextBlock Name="lblMode" Text="MULTIPLAYER" FontSize="20" FontWeight="Black" Foreground="{StaticResource Accent}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Name="lblCount" Text="" FontSize="10" Foreground="{StaticResource TextFaint}" Margin="1,0,0,8" />
        <Grid Margin="0,0,0,8">
          <TextBox Name="txtSearch" />
          <TextBlock Name="lblHint" Text="search packs" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
        <RichTextBox Name="txtNotes" Style="{StaticResource GlassRich}" Height="96" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Margin="0,8,0,8" Foreground="{StaticResource TextDim}">
          <FlowDocument PagePadding="0" />
        </RichTextBox>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <Button Name="btnUse" Grid.Column="0" Content="USE THIS PACK" Style="{StaticResource GoBtn}" Height="40" IsEnabled="False" />
          <Button Name="btnCustom" Grid.Column="2" Content="CUSTOM GSC" Style="{StaticResource BigBtn}" Height="40" FontSize="13" FontWeight="Bold" ToolTip="Pick your own PS4-format .gscc / .gsc file instead of a bundled pack" />
        </Grid>
      </StackPanel>
      <Border Style="{StaticResource GlassInset}" Padding="4">
        <ListBox Name="list" Background="#00000000" BorderThickness="0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#B4BAC8" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>
  </Border>
</Window>
