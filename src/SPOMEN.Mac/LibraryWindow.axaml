<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SPOMEN.Mac"
        x:Class="SPOMEN.Mac.LibraryWindow"
        x:DataType="local:LibraryWindow"
        Title="Library" Width="540" Height="580" CanResize="False"
        Background="Transparent" TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Foreground="#EEF0F5"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://SPOMEN/Theme.axaml" />
  </Window.Styles>

  <Panel>
    <Border Background="{StaticResource Backdrop}" />
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="#0E1016" TintOpacity="0.82" MaterialOpacity="0.6" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Border Classes="glass" Margin="16,14,16,16" Padding="22,18,22,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="LIBRARY" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" />
            <TextBlock Name="lblMode" Text="MULTIPLAYER" FontSize="20" FontWeight="Black" Foreground="{StaticResource Accent}" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Name="lblCount" Text="" FontSize="10" Foreground="{StaticResource TextFaint}" Margin="1,0,0,8" />
          <TextBox Name="txtSearch" Watermark="search packs" Margin="0,0,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Classes="inset" Height="96" Margin="0,8,0,8" Padding="8,6,8,6">
            <ScrollViewer Name="notesScroll" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock Name="txtNotes" FontFamily="Menlo, Consolas, monospace" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
            </ScrollViewer>
          </Border>
          <Grid ColumnDefinitions="*,8,150">
            <Button Name="btnUse" Grid.Column="0" Classes="go" Content="USE THIS PACK" Height="40" IsEnabled="False" />
            <Button Name="btnCustom" Grid.Column="2" Classes="big" Content="CUSTOM GSC" Height="40" FontSize="13" FontWeight="Bold" ToolTip.Tip="Pick your own PS4-format .gscc / .gsc file instead of a bundled pack" />
          </Grid>
        </StackPanel>
        <Border Classes="inset" Padding="4">
          <ListBox Name="list" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:LibraryWindow+Row">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#B4BAC8" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Border>
  </Panel>
</Window>
