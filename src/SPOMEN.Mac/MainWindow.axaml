<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SPOMEN.Mac.MainWindow"
        Title="BO2 Injector"
        Width="540" SizeToContent="Height" CanResize="False"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent" TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Foreground="#EEF0F5"
        WindowStartupLocation="CenterScreen"
        Icon="avares://SPOMEN/Assets/icon.png">
  <Window.Styles>
    <StyleInclude Source="avares://SPOMEN/Theme.axaml" />
  </Window.Styles>

  <Panel>
    <!-- backdrop: real blur where the platform supports it, dark gradient underneath otherwise -->
    <Border Background="{StaticResource Backdrop}" />
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="#0E1016" TintOpacity="0.82" MaterialOpacity="0.6" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Border Background="{StaticResource Surface}" Padding="28,14,28,16">
      <StackPanel>
        <!-- title bar: traffic lights + header; the whole strip drags the window -->
        <StackPanel Name="titleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" Margin="-12,0,0,12">
            <Button Name="btnWinClose" Classes="traffic close" />
            <Button Name="btnWinMin" Classes="traffic min" />
            <Button Name="btnWinMax" Classes="traffic max" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Name="dot" Width="13" Height="13" Fill="#7A3030" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="BO2  INJECTOR" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" />
          </StackPanel>
          <TextBlock Text="PS4DEBUG  •  GOLDHEN" FontSize="10" Foreground="{StaticResource Accent}" Margin="33,0,0,2" />
        </StackPanel>
        <Rectangle Height="2" Margin="0,6,0,14" RadiusX="1" RadiusY="1">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#FF7A00" Offset="0" />
              <GradientStop Color="#00FF7A00" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <TextBlock Name="lblStatus" Text="Disconnected" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,12" />

        <Border Classes="inset" CornerRadius="20" Margin="0,0,0,4">
          <UniformGrid Columns="2">
            <RadioButton Name="segMp" Classes="seg" Content="MULTIPLAYER" GroupName="game" IsChecked="True" />
            <RadioButton Name="segZm" Classes="seg" Content="ZOMBIES" GroupName="game" />
          </UniformGrid>
        </Border>
        <Border Name="subRow" Classes="inset" CornerRadius="13" Margin="90,0,90,4">
          <UniformGrid Columns="2">
            <RadioButton Name="segMenus" Classes="seg small" Content="MOD MENUS" GroupName="mpkind" IsChecked="True" />
            <RadioButton Name="segGm" Classes="seg small" Content="GAME MODES" GroupName="mpkind" />
          </UniformGrid>
        </Border>
        <TextBlock Name="lblTarget" Text="maps/mp/gametypes/_clientids.gsc" Foreground="{StaticResource TextFaint}" FontSize="10"
                   FontFamily="Menlo, Consolas, monospace" HorizontalAlignment="Center" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Text="PS4 IP" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,4" />
            <TextBox Name="txtIp" Text="192.168.100.66" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="gsc file" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,4" />
            <TextBox Name="txtFile" IsReadOnly="True" Text="No file selected" />
          </StackPanel>
        </Grid>

        <UniformGrid Columns="2" Rows="1" Margin="0,2,0,0">
          <Button Name="btnConnect" Classes="big" Content="Connect" Height="52" Margin="0,0,5,0" />
          <Button Name="btnAttach" Classes="big" Content="Attach" Height="52" Margin="5,0,0,0" />
        </UniformGrid>
        <Button Name="btnLib" Classes="big" Content="Library" Height="52" Margin="0,10,0,0" />
        <Button Name="btnInj" Classes="big" Content="INJECT" Height="48" Margin="0,10,0,0" FontSize="16" FontWeight="Bold" BorderBrush="{StaticResource Accent}" />
        <Button Name="btnPublic" Classes="go" Content="PUBLIC MATCH" Height="40" Margin="0,10,0,0" />
        <Button Name="btnUninject" Classes="big" Content="UNINJECT ALL" Height="40" Margin="0,8,0,0" FontSize="13" FontWeight="Bold" ToolTip.Tip="Restore the stock script(s) replaced by this session. Start a new match afterwards." />

        <Border Classes="inset" Margin="0,10,0,0" Padding="10,2,4,2">
          <DockPanel>
            <TextBlock Text="&gt;" DockPanel.Dock="Left" Foreground="{StaticResource Accent}" FontFamily="Menlo, Consolas, monospace" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Name="btnSend" Classes="mini" Content="SEND" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBox Name="txtCmd" Classes="cmd" Background="Transparent" BorderThickness="0" FontFamily="Menlo, Consolas, monospace" FontSize="12" Padding="0,4,0,4" VerticalContentAlignment="Center"
                     Watermark="console command  ·  Enter to send, arrows for history" />
          </DockPanel>
        </Border>

        <Border Classes="inset" Margin="0,8,0,0" Height="100" Padding="8,6,8,6">
          <ScrollViewer Name="logScroll" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Name="txtLog" FontFamily="Menlo, Consolas, monospace" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
          </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
          <TextBlock Text="by Aban" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="  ·  thank you Medo for the base" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</Window>
