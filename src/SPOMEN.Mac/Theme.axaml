<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Glass theme shared by every window. Colours mirror src/BO2InjectorGUI/Theme.xaml. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="Accent">#FF7A00</SolidColorBrush>
    <SolidColorBrush x:Key="Ink">#0B0C0E</SolidColorBrush>
    <SolidColorBrush x:Key="Text">#EEF0F5</SolidColorBrush>
    <SolidColorBrush x:Key="TextDim">#B4BAC8</SolidColorBrush>
    <SolidColorBrush x:Key="TextFaint">#7C8497</SolidColorBrush>
    <SolidColorBrush x:Key="Surface">#A60E1016</SolidColorBrush>
    <SolidColorBrush x:Key="Glass">#8C141721</SolidColorBrush>
    <SolidColorBrush x:Key="GlassStrong">#5E1B1F2A</SolidColorBrush>
    <SolidColorBrush x:Key="GlassInput">#4A0D0F14</SolidColorBrush>
    <SolidColorBrush x:Key="GlassHover">#8C2A2F3C</SolidColorBrush>
    <SolidColorBrush x:Key="Hairline">#22FFFFFF</SolidColorBrush>
    <LinearGradientBrush x:Key="Backdrop" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#1A1410" Offset="0" />
      <GradientStop Color="#0E1016" Offset="0.45" />
      <GradientStop Color="#0C1020" Offset="1" />
    </LinearGradientBrush>
    <!-- Fluent scrollbar brushes -->
    <SolidColorBrush x:Key="ScrollBarThumbFill">#26FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#66FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed">#FF7A00</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbBackground">#26FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPointerOver">#66FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed">#FF7A00</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFill">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver">#14161B</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackStroke">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver">Transparent</SolidColorBrush>
    <!-- traffic-light glyphs (shown on hover) -->
    <StreamGeometry x:Key="GlyphClose">M0,0 L6,6 M6,0 L0,6</StreamGeometry>
    <StreamGeometry x:Key="GlyphMin">M0,3 L6,3</StreamGeometry>
    <StreamGeometry x:Key="GlyphMax">M0,3 L6,3 M3,0 L3,6</StreamGeometry>
  </Styles.Resources>

  <!-- panels -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource Glass}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 6 28 0 #73000000" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource GlassInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- buttons -->
  <Style Selector="Button.big">
    <Setter Property="Background" Value="{StaticResource GlassStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.big:pointerover">
    <Setter Property="Background" Value="{StaticResource GlassHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.big:pressed">
    <Setter Property="Background" Value="#40FF7A00" />
  </Style>
  <Style Selector="Button.big:disabled">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.go">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}" BoxShadow="0 0 22 0 #73FF7A00" BorderThickness="1" BorderBrush="#40FFFFFF">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.go:pointerover">
    <Setter Property="Background" Value="#FF8F2A" />
  </Style>
  <Style Selector="Button.go:pressed">
    <Setter Property="Background" Value="#E56D00" />
  </Style>
  <Style Selector="Button.go:disabled">
    <Setter Property="Background" Value="#4A3A2A18" />
    <Setter Property="Foreground" Value="#7A5A38" />
  </Style>
  <Style Selector="Button.mini">
    <Setter Property="Background" Value="{StaticResource GlassStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="10,4,10,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.mini:pointerover">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <!-- segmented pills -->
  <Style Selector="RadioButton.seg">
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="0,7,0,7" Margin="3">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg.small">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="0,4,0,4" Margin="2">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:pointerover">
    <Setter Property="Background" Value="{StaticResource GlassHover}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <!-- inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource GlassInput}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7,10,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource GlassInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource GlassInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBox.cmd /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="12,7,12,7" />
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="CornerRadius" Value="0,10,10,0" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FF7A00" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- window chrome: mac-style traffic lights (system chrome is hidden by ExtendClientAreaChromeHints=NoChrome) -->
  <Style Selector="Button.traffic">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Ellipse Name="dot" Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="0.5" />
          <Path Name="glyph" Data="{TemplateBinding Tag}" Stroke="#A6000000" StrokeThickness="1.4" StrokeLineCap="Round" Width="6" Height="6" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.traffic:pointerover /template/ Path#glyph">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.traffic:pressed /template/ Ellipse#dot">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Button.traffic:disabled">
    <Setter Property="Opacity" Value="0.35" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.traffic.close">
    <Setter Property="Background" Value="#FF5F57" />
    <Setter Property="Tag" Value="{StaticResource GlyphClose}" />
    <Setter Property="ToolTip.Tip" Value="Close" />
  </Style>
  <Style Selector="Button.traffic.min">
    <Setter Property="Background" Value="#FEBC2E" />
    <Setter Property="Tag" Value="{StaticResource GlyphMin}" />
    <Setter Property="ToolTip.Tip" Value="Minimize" />
  </Style>
  <Style Selector="Button.traffic.max">
    <Setter Property="Background" Value="#28C840" />
    <Setter Property="Tag" Value="{StaticResource GlyphMax}" />
    <Setter Property="IsEnabled" Value="False" />
  </Style>
</Styles>
